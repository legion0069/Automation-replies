# Meta Developer Credentials
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
VERIFY_TOKEN=your_secure_webhook_verify_token_here
PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Application & Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=false
ADMIN_API_KEY=change_this_to_a_secure_random_key

# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./instagram_automation.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_automation

# Path to Dynamic JSON Configuration
CONFIG_PATH=./config.json
